---
/**
 * AuthorDate — Displays author bio + publication/update dates.
 * Reusable on Security, FAQ, Updates, and Tuto pages.
 */
import { getLangFromUrl, t } from '../../i18n/utils';

interface Props {
  datePublished: string; // ISO format: "2026-02-09"
  dateModified?: string; // ISO format: "2026-02-14"
}

const { datePublished, dateModified } = Astro.props;
const lang = getLangFromUrl(Astro.url);

function formatDate(iso: string, locale: string): string {
  const d = new Date(iso + 'T00:00:00');
  return d.toLocaleDateString(locale === 'fr' ? 'fr-FR' : 'en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<div class="mt-12 pt-6 border-t border-chill-border flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
  <div class="flex items-center gap-3">
    <div class="w-9 h-9 rounded-full bg-chill-accent/15 flex items-center justify-center shrink-0">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-chill-accent">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
        <circle cx="12" cy="7" r="4" />
      </svg>
    </div>
    <div>
      <p class="text-body-sm font-heading font-semibold text-chill-text">{t(lang, 'author.name')}</p>
      <p class="text-micro text-chill-text-muted">{t(lang, 'author.role')}</p>
    </div>
  </div>
  <div class="text-micro text-chill-text-muted font-mono">
    <span>{t(lang, 'meta.published')} <time datetime={datePublished}>{formatDate(datePublished, lang)}</time></span>
    {dateModified && dateModified !== datePublished && (
      <span class="ml-3">{t(lang, 'meta.updated')} <time datetime={dateModified}>{formatDate(dateModified, lang)}</time></span>
    )}
  </div>
</div>
