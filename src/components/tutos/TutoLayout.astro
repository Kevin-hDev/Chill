---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaHowTo from '../seo/SchemaHowTo.astro';
import SchemaBreadcrumb from '../seo/SchemaBreadcrumb.astro';
import AuthorDate from '../ui/AuthorDate.astro';
import { getLangFromUrl, getLocalePath } from '../../i18n/utils';

interface HowToStep {
  name: string;
  text: string;
}

interface Props {
  title: string;
  intro: string;
  description?: string;
  showOsTabs?: boolean;
  showChillCta?: boolean;
  howToSteps?: HowToStep[];
  breadcrumbs?: { name: string; url: string }[];
  datePublished?: string;
  dateModified?: string;
}

const { title, intro, description, showOsTabs = true, showChillCta = false, howToSteps, breadcrumbs, datePublished = '2026-02-09', dateModified = '2026-02-14' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const chillPath = getLocalePath(lang, '/chill');
---

<BaseLayout title={`${title} — Chill`} description={description}>
  {howToSteps && howToSteps.length > 0 && (
    <SchemaHowTo name={title} description={intro} steps={howToSteps} />
  )}
  {breadcrumbs && breadcrumbs.length > 0 && (
    <SchemaBreadcrumb items={breadcrumbs} />
  )}

  <section class="py-12">
    <h1 data-animate="0" class="text-h1 font-heading font-bold text-chill-text mb-4">
      {title}
    </h1>
    <p data-animate="100" class="text-body text-chill-text-secondary mb-10 max-w-3xl">
      {intro}
      {showChillCta && (
        <>
          {' '}
          {lang === 'fr'
            ? <span>Télécharge l'application <a href={chillPath} class="text-chill-accent hover:underline font-semibold">Chill</a> pour tout configurer en trois clics, ou suis les étapes ci-dessous pour tout configurer manuellement.</span>
            : <span>Download the <a href={chillPath} class="text-chill-accent hover:underline font-semibold">Chill</a> app to set up everything in three clicks, or follow the steps below for manual configuration.</span>
          }
        </>
      )}
    </p>

    <slot />

    <AuthorDate datePublished={datePublished} dateModified={dateModified} />
  </section>
</BaseLayout>
