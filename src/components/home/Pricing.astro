---
import { getLangFromUrl, t } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
---

<section class="py-12 md:py-20 text-center">
  <h2 data-animate="0" class="text-h2 font-heading font-bold text-chill-text">
    {t(lang, 'pricing.title')}
  </h2>

  <!-- CTA — GitHub open source -->
  <div data-animate="200" class="flex flex-col sm:flex-row gap-4 justify-center items-center mt-8">
    <a href="https://github.com/Kevin-hDev" target="_blank" rel="noopener noreferrer" class="inline-block hover:opacity-80 transition-opacity">
      <img
        src="/images/icons_github.png"
        alt="GitHub"
        width="87"
        height="87"
        class="h-[87px] w-auto"
      />
    </a>
  </div>

  <!-- Warning — fichiers à lire -->
  <p data-animate="300" class="mt-6 text-body-sm text-chill-text-muted max-w-xl mx-auto leading-relaxed">
    {t(lang, 'pricing.warning')}
  </p>
</section>
