---
import { getLangFromUrl, t } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
---

<section class="py-12 md:py-20 text-center">
  <h2 data-animate="0" class="text-h2 font-heading font-bold text-chill-text">
    {t(lang, 'pricing.title')}
  </h2>
  <p data-animate="100" class="text-body text-chill-text-secondary mt-3">
    {t(lang, 'pricing.subtitle')}
  </p>

  <!-- CTA buttons — Official store badges -->
  <div data-animate="200" class="flex flex-col sm:flex-row gap-4 justify-center items-center mt-8">
    <a href="https://play.google.com/store/apps/details?id=com.chill.shell" rel="noopener noreferrer" class="inline-block hover:opacity-80 transition-opacity">
      <img
        src="/images/badges/google-play-badge.png"
        alt="Get it on Google Play"
        width="210"
        height="62"
        class="h-[62px] w-auto"
      />
    </a>
    <!-- App Store — masqué temporairement, réactiver quand prêt
    <a href="https://apps.apple.com/app/chillshell/id0000000000" class="inline-block hover:opacity-80 transition-opacity">
      <img
        src="/images/badges/app-store-badge.svg"
        alt="Download on the App Store"
        width="162"
        height="48"
        class="h-[48px] w-auto"
      />
    </a>
    -->
  </div>
</section>
