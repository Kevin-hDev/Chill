---
import { getLangFromUrl, t } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
---

<section class="py-12 md:py-20">
  <h2 data-animate="0" class="text-h2 font-heading font-bold text-chill-text text-center">
    {t(lang, 'differentiator.title')}
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-12">
    <!-- Card 1: Security -->
    <div data-animate="100" class="bg-chill-elevated border border-chill-border rounded-chill-xl p-6 hover:border-chill-accent transition-colors duration-300">
      <div class="flex items-start gap-4">
        <svg class="w-6 h-6 text-chill-accent shrink-0" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
        </svg>
        <div>
          <h3 class="text-h3 font-heading font-semibold text-chill-text">
            {t(lang, 'differentiator.security')}
          </h3>
          <p class="text-body-sm text-chill-text-secondary mt-2">
            {t(lang, 'differentiator.securityDesc')}
          </p>
        </div>
      </div>
    </div>

    <!-- Card 2: AI Agents -->
    <div data-animate="200" class="bg-chill-elevated border border-chill-border rounded-chill-xl p-6 hover:border-chill-accent transition-colors duration-300">
      <div class="flex items-start gap-4">
        <svg class="w-6 h-6 text-chill-accent shrink-0" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" />
        </svg>
        <div>
          <h3 class="text-h3 font-heading font-semibold text-chill-text">
            {t(lang, 'differentiator.agents')}
          </h3>
          <p class="text-body-sm text-chill-text-secondary mt-2">
            {t(lang, 'differentiator.agentsDesc')}
          </p>
        </div>
      </div>
    </div>

    <!-- Card 3: Offline -->
    <div data-animate="300" class="bg-chill-elevated border border-chill-border rounded-chill-xl p-6 hover:border-chill-accent transition-colors duration-300">
      <div class="flex items-start gap-4">
        <svg class="w-6 h-6 text-chill-accent shrink-0" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l8.735 8.735m0 0a.374.374 0 11.53.53m-.53-.53l.53.53m0 0L21 21M14.652 9.348a3.75 3.75 0 010 5.304m2.121-7.425a6.75 6.75 0 010 9.546m2.121-11.667c3.808 3.807 3.808 9.98 0 13.788m-9.546-4.242a3.733 3.733 0 01-1.06-2.122m-1.061 4.243a6.75 6.75 0 01-1.625-6.929m-.496 9.05c-3.068-3.067-3.664-7.67-1.79-11.334M12 12h.008v.008H12V12z" />
        </svg>
        <div>
          <h3 class="text-h3 font-heading font-semibold text-chill-text">
            {t(lang, 'differentiator.offline')}
          </h3>
          <p class="text-body-sm text-chill-text-secondary mt-2">
            {t(lang, 'differentiator.offlineDesc')}
          </p>
        </div>
      </div>
    </div>

    <!-- Card 4: Transparent -->
    <div data-animate="400" class="bg-chill-elevated border border-chill-border rounded-chill-xl p-6 hover:border-chill-accent transition-colors duration-300">
      <div class="flex items-start gap-4">
        <svg class="w-6 h-6 text-chill-accent shrink-0" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <div>
          <h3 class="text-h3 font-heading font-semibold text-chill-text">
            {t(lang, 'differentiator.open')}
          </h3>
          <p class="text-body-sm text-chill-text-secondary mt-2">
            {t(lang, 'differentiator.openDesc')}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
