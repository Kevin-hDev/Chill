---
// HeroChill.astro - Brand hero section for the "Chill" umbrella brand
---

<section class="py-20">
  <div class="flex flex-col items-center text-center">
    <!-- Logo with green emerald halo effect -->
    <div class="relative">
      <!-- Halo effect behind logo -->
      <div
        class="absolute inset-0 w-48 h-48 -translate-x-1/2 -translate-y-1/2 top-1/2 left-1/2"
        style="background: radial-gradient(circle, var(--color-accent-glow) 0%, transparent 70%);"
        aria-hidden="true"
      ></div>

      <!-- Logo image with float animation -->
      <img
        src="/images/logo-chill.png"
        alt="Chill"
        class="w-24 h-24 animate-float relative z-10"
        width="96"
        height="96"
      />
    </div>

    <!-- Brand name -->
    <h1 class="text-hero-h1 font-heading font-bold text-chill-text mt-8">
      Chill
    </h1>
  </div>
</section>
