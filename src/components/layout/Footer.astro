---
import { getLangFromUrl, t, getLocalePath } from '../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
---

<footer class="border-t border-chill-border py-8 mt-24">
  <div data-animate="0" class="max-w-[var(--container-page)] mx-auto px-6 flex flex-wrap items-center justify-center gap-4 text-micro text-chill-text-muted">
    <span class="font-heading font-bold text-chill-text-secondary">Chill</span>
    <span>&copy; 2026 Chill</span>
    <a href={getLocalePath(lang, '/mentions-legales')} class="hover:text-chill-text transition-colors">
      {t(lang, 'footer.legal')}
    </a>
    <a href={getLocalePath(lang, '/cgu')} class="hover:text-chill-text transition-colors">
      {t(lang, 'footer.terms')}
    </a>
    <a href={getLocalePath(lang, '/politique-confidentialite')} class="hover:text-chill-text transition-colors">
      {t(lang, 'footer.privacy')}
    </a>
    <a href={getLocalePath(lang, '/about')} class="hover:text-chill-text transition-colors">
      {t(lang, 'footer.about')}
    </a>
    <a href={getLocalePath(lang, '/contact')} class="hover:text-chill-text transition-colors">
      {t(lang, 'footer.contact')}
    </a>
  </div>
</footer>
