---
import NavDropdown from './NavDropdown.tsx';
import MobileMenu from './MobileMenu.tsx';
import ThemeToggle from '../ui/ThemeToggle.tsx';
import LanguageToggle from '../ui/LanguageToggle.tsx';
import { getLangFromUrl, t, getLocalePath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const currentPath = Astro.url.pathname;

const tutoItems = [
  { label: t(lang, 'nav.tutos.configOs'), href: getLocalePath(lang, '/tutos/config-os') },
  { label: t(lang, 'nav.tutos.ssh'), href: getLocalePath(lang, '/tutos/ssh') },
  { label: t(lang, 'nav.tutos.tailscale'), href: getLocalePath(lang, '/tutos/tailscale') },
  { label: t(lang, 'nav.tutos.bios'), href: getLocalePath(lang, '/tutos/bios') },
  { label: t(lang, 'nav.tutos.wol'), href: getLocalePath(lang, '/tutos/wol') },
  { label: t(lang, 'nav.tutos.agentsCli'), href: getLocalePath(lang, '/tutos/agents-cli') },
];

const navItems = [
  { label: t(lang, 'nav.security'), href: getLocalePath(lang, '/securite') },
  { label: t(lang, 'nav.updates'), href: getLocalePath(lang, '/updates') },
  { label: t(lang, 'nav.faq'), href: getLocalePath(lang, '/faq') },
];
---

<header class="w-full">
  <!-- Logo Chill centré au-dessus -->
  <div class="flex items-center justify-between px-4 pt-6 pb-3 md:justify-center md:px-0 md:pt-8 md:pb-4">
    <!-- Mobile: hamburger on the left -->
    <MobileMenu
      client:load
      tutoLabel={t(lang, 'nav.tutos')}
      tutoItems={tutoItems}
      navItems={navItems}
    />

    <!-- Logo (centered, bigger with halo) -->
    <a href={getLocalePath(lang, '/')} class="flex flex-col items-center gap-2 md:gap-3 group relative animate-fade-in-up">
      <div class="relative">
        <div
          class="absolute inset-0 w-32 h-32 md:w-40 md:h-40 -translate-x-1/2 -translate-y-1/2 top-1/2 left-1/2"
          style="background: radial-gradient(circle, var(--color-accent-glow) 0%, transparent 70%);"
          aria-hidden="true"
        ></div>
        <img
          src="/images/logo-chill.png"
          alt="Chill"
          class="w-16 h-16 md:w-24 md:h-24 animate-float relative z-10"
          width="96"
          height="96"
        />
      </div>
      <span class="text-h3 md:text-h2 font-heading font-bold text-chill-text group-hover:text-chill-accent transition-colors">
        Chill
      </span>
    </a>

    <!-- Mobile: theme + lang toggles on the right -->
    <div class="flex items-center gap-1 md:hidden">
      <ThemeToggle client:load />
      <LanguageToggle currentLang={lang} currentPath={currentPath} />
    </div>
  </div>

  <!-- Desktop Navbar (hidden on mobile) -->
  <nav class="hidden md:flex items-center justify-center gap-8 py-4 border-b border-chill-border animate-fade-in-up" style="animation-delay: 0.15s;">
    <NavDropdown label={t(lang, 'nav.tutos')} items={tutoItems} client:load />
    <a href={getLocalePath(lang, '/securite')} class="text-body-sm text-chill-text-secondary hover:text-chill-text transition-colors">
      {t(lang, 'nav.security')}
    </a>
    <a href={getLocalePath(lang, '/updates')} class="text-body-sm text-chill-text-secondary hover:text-chill-text transition-colors">
      {t(lang, 'nav.updates')}
    </a>
    <a href={getLocalePath(lang, '/faq')} class="text-body-sm text-chill-text-secondary hover:text-chill-text transition-colors">
      {t(lang, 'nav.faq')}
    </a>

    <div class="flex items-center gap-2 ml-4">
      <ThemeToggle client:load />
      <LanguageToggle currentLang={lang} currentPath={currentPath} />
    </div>
  </nav>

  <!-- Mobile border bottom separator -->
  <div class="border-b border-chill-border md:hidden"></div>
</header>
