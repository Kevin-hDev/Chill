---
/**
 * Schema.org HowTo JSON-LD
 * For tutorial pages — describes step-by-step guides.
 */
interface HowToStep {
  name: string;
  text: string;
}

interface Props {
  name: string;
  description: string;
  steps: HowToStep[];
}

const { name, description, steps } = Astro.props;
---

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": name,
  "description": description,
  "totalTime": "PT15M",
  "step": steps.map((step, i) => ({
    "@type": "HowToStep",
    "position": i + 1,
    "name": step.name,
    "text": step.text
  }))
})} />
