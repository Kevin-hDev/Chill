---
/**
 * Schema.org WebPage JSON-LD
 * For content pages (Security, About, etc.)
 */
interface Props {
  name: string;
  description: string;
  url: string;
  datePublished: string;
  dateModified?: string;
}

const { name, description, url, datePublished, dateModified } = Astro.props;
---

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": name,
  "description": description,
  "url": url,
  "datePublished": datePublished,
  "dateModified": dateModified || datePublished,
  "author": {
    "@type": "Person",
    "name": "HUYNH Kevin"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Chill",
    "url": "https://chill.app"
  }
})} />
