---
/**
 * Schema.org Organization JSON-LD
 * Global schema for the ChillShell brand identity.
 */
---

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "ChillShell",
  "alternateName": "Chill",
  "url": "https://chill.app",
  "logo": "https://chill.app/images/logo-chill.png",
  "description": "Mobile SSH terminal app for developers. Connect to your servers securely from your phone with SSH, Tailscale VPN, Wake-on-LAN, and AI CLI agents.",
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer service",
    "email": "contact@chill.app"
  },
  "sameAs": []
})} />
