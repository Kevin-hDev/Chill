---
import BaseLayout from '../layouts/BaseLayout.astro';
import SchemaFAQ from '../components/seo/SchemaFAQ.astro';
import SchemaBreadcrumb from '../components/seo/SchemaBreadcrumb.astro';
import AuthorDate from '../components/ui/AuthorDate.astro';
import { getLangFromUrl, t } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const generalItems = [
  { question: t(lang, 'faq.q1'), answer: t(lang, 'faq.a1') },
  { question: t(lang, 'faq.q2'), answer: t(lang, 'faq.a2') },
  { question: t(lang, 'faq.q3'), answer: t(lang, 'faq.a3') },
  { question: t(lang, 'faq.q4'), answer: t(lang, 'faq.a4') },
  { question: t(lang, 'faq.q5'), answer: t(lang, 'faq.a5') },
  { question: t(lang, 'faq.q6'), answer: t(lang, 'faq.a6') },
];

const chillshellItems = [
  { question: t(lang, 'faq.q7'), answer: t(lang, 'faq.a7') },
  { question: t(lang, 'faq.q8'), answer: t(lang, 'faq.a8') },
  { question: t(lang, 'faq.q9'), answer: t(lang, 'faq.a9') },
  { question: t(lang, 'faq.q10'), answer: t(lang, 'faq.a10') },
];

const chillItems = [
  { question: t(lang, 'faq.q11'), answer: t(lang, 'faq.a11') },
  { question: t(lang, 'faq.q12'), answer: t(lang, 'faq.a12') },
  { question: t(lang, 'faq.q13'), answer: t(lang, 'faq.a13') },
  { question: t(lang, 'faq.q14'), answer: t(lang, 'faq.a14') },
];

const allItems = [...generalItems, ...chillshellItems, ...chillItems];

const breadcrumbs = [
  { name: 'Home', url: 'https://chill.app/' },
  { name: 'FAQ', url: 'https://chill.app/faq' },
];
---

<BaseLayout title={t(lang, 'faq.pageTitle')} description={t(lang, 'faq.description')}>
  <SchemaFAQ items={allItems} />
  <SchemaBreadcrumb items={breadcrumbs} />

  <section class="py-[var(--spacing-section)]">
    <h1 data-animate="0" class="text-hero-h1 font-heading font-bold text-chill-text mb-12">
      {t(lang, 'faq.title')}
    </h1>

    <!-- General -->
    <h2 data-animate="50" class="text-h3 font-heading font-bold text-chill-text mb-4">{t(lang, 'faq.section.general')}</h2>
    <div class="space-y-3 mb-10">
      {generalItems.map((item, i) => (
        <div data-animate={String(100 + i * 40)} class="rounded-chill border border-chill-border bg-chill-elevated overflow-hidden">
          <h3 class="px-5 py-3 text-body-sm font-medium text-chill-text font-heading">{item.question}</h3>
          <div class="px-5 pb-4 pt-1 border-t border-chill-border bg-chill-surface">
            <p class="text-micro text-chill-text-secondary leading-relaxed">{item.answer}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- ChillShell -->
    <h2 data-animate="350" class="text-h3 font-heading font-bold text-chill-text mb-4">{t(lang, 'faq.section.chillshell')}</h2>
    <div class="space-y-3 mb-10">
      {chillshellItems.map((item, i) => (
        <div data-animate={String(400 + i * 40)} class="rounded-chill border border-chill-border bg-chill-elevated overflow-hidden">
          <h3 class="px-5 py-3 text-body-sm font-medium text-chill-text font-heading">{item.question}</h3>
          <div class="px-5 pb-4 pt-1 border-t border-chill-border bg-chill-surface">
            <p class="text-micro text-chill-text-secondary leading-relaxed">{item.answer}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Chill -->
    <h2 data-animate="600" class="text-h3 font-heading font-bold text-chill-text mb-4">{t(lang, 'faq.section.chill')}</h2>
    <div class="space-y-3">
      {chillItems.map((item, i) => (
        <div data-animate={String(650 + i * 40)} class="rounded-chill border border-chill-border bg-chill-elevated overflow-hidden">
          <h3 class="px-5 py-3 text-body-sm font-medium text-chill-text font-heading">{item.question}</h3>
          <div class="px-5 pb-4 pt-1 border-t border-chill-border bg-chill-surface">
            <p class="text-micro text-chill-text-secondary leading-relaxed">{item.answer}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Related tutorials -->
    <div data-animate="100" class="mt-12 rounded-chill border border-chill-border bg-chill-elevated p-5">
      <h3 class="text-body-sm font-heading font-semibold text-chill-text mb-3">Related tutorials</h3>
      <div class="flex flex-wrap gap-3">
        <a href="/tutos/config-os" class="text-body-sm text-chill-accent hover:underline">OS Setup &rarr;</a>
        <a href="/tutos/ssh" class="text-body-sm text-chill-accent hover:underline">SSH Connection &rarr;</a>
        <a href="/tutos/tailscale" class="text-body-sm text-chill-accent hover:underline">Tailscale VPN &rarr;</a>
        <a href="/tutos/wol" class="text-body-sm text-chill-accent hover:underline">Wake-on-LAN &rarr;</a>
        <a href="/securite" class="text-body-sm text-chill-accent hover:underline">Security &rarr;</a>
      </div>
    </div>

    <AuthorDate datePublished="2026-02-21" dateModified="2026-02-21" />
  </section>
</BaseLayout>
