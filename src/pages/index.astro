---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, t } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
---

<BaseLayout title="Chill — Your desktop terminal. In your pocket.">
  <div class="py-24 text-center">
    <h1 class="text-hero-h1 text-chill-text font-heading">Chill</h1>
    <p class="text-body text-chill-text-secondary mt-4">
      {t(lang, 'hero.tagline')}
    </p>
    <p class="text-body-sm text-chill-text-muted mt-2">Site en construction</p>
  </div>
</BaseLayout>
