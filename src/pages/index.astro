---
import BaseLayout from '../layouts/BaseLayout.astro';
import SchemaOrganization from '../components/seo/SchemaOrganization.astro';
import SchemaSoftwareApp from '../components/seo/SchemaSoftwareApp.astro';
import HeroChillShell from '../components/home/HeroChillShell.tsx';
import SectionPerspective from '../components/home/SectionPerspective.tsx';
import SectionFade from '../components/home/SectionFade.tsx';
import Differentiator from '../components/home/Differentiator.astro';
import Pricing from '../components/home/Pricing.astro';
import { getLangFromUrl, t } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const terminalImages = [
  { src: '/images/screenshots/en/dark/terminal-1.png', srcLight: '/images/screenshots/en/light/terminal-1.png', alt: 'Terminal SSH view' },
  { src: '/images/screenshots/en/dark/terminal-2.png', srcLight: '/images/screenshots/en/light/terminal-2.png', alt: 'Agent CLI running' },
  { src: '/images/screenshots/en/dark/terminal-3.png', srcLight: '/images/screenshots/en/light/terminal-3.png', alt: 'Multi-session terminal' },
];

const connectionImages = [
  { src: '/images/screenshots/en/dark/connect-1.png', srcLight: '/images/screenshots/en/light/connect-1.png', alt: 'ChillShell connection dashboard' },
];

const customizeImages = [
  { src: '/images/screenshots/en/dark/theme-1.png', srcLight: '/images/screenshots/en/light/theme-1.png', alt: 'Settings with 12 color themes' },
  { src: '/images/screenshots/en/dark/theme-2.png', srcLight: '/images/screenshots/en/light/theme-2.png', alt: 'PIN and fingerprint lock screen' },
  { src: '/images/screenshots/en/dark/theme-3.png', srcLight: '/images/screenshots/en/light/theme-3.png', alt: 'Tailscale VPN and SSH keys' },
];
---

<BaseLayout title={t(lang, 'home.title')} description={t(lang, 'home.description')}>
  <SchemaOrganization />
  <SchemaSoftwareApp lang={lang} />

  <!-- Product Hero (ChillShell) -->
  <HeroChillShell
    client:visible
    tagline={t(lang, 'hero.tagline')}
    subtitle={t(lang, 'hero.subtitle')}
  />

  <hr class="section-divider" />

  <!-- Section 1: Terminal (3D perspective, left) -->
  <SectionPerspective
    client:visible
    side="left"
    images={terminalImages}
    title={t(lang, 'sections.terminal.title')}
    description={t(lang, 'sections.terminal.description')}
  />

  <hr class="section-divider" />

  <!-- Section 2: Connections (fade edges) -->
  <SectionFade
    client:visible
    images={connectionImages}
    title={t(lang, 'sections.connections.title')}
    description={t(lang, 'sections.connections.description')}
    side="right"
    aspectRatio="919/518"
    fadeBottomLeft
    diagonalText
  />

  <hr class="section-divider" />

  <!-- Section 3: Customization (3D perspective, left — same orientation as Terminal) -->
  <SectionPerspective
    client:visible
    side="left"
    images={customizeImages}
    title={t(lang, 'sections.customize.title')}
    description={t(lang, 'sections.customize.description')}
  />

  <hr class="section-divider" />

  <!-- Differentiator (Why ChillShell?) -->
  <Differentiator />

  <hr class="section-divider" />

  <!-- Pricing -->
  <Pricing />
</BaseLayout>
