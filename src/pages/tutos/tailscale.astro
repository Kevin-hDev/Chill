---
import TutoLayout from '../../components/tutos/TutoLayout.astro';
import TailscaleContent from '../../components/tutos/TailscaleContent.tsx';
import { getLangFromUrl, t } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const win = [
  {
    title: t(lang, 'tutos.tailscale.step1.title'),
    content: t(lang, 'tutos.tailscale.step1.content'),
    link: { url: 'https://login.tailscale.com/login?next_url=%2Fwelcome', label: t(lang, 'tutos.tailscale.step1.linkLabel') },
    image: { src: '/images/tutos/tailscale/tailscale-login.png', alt: 'Tailscale login page', maxWidth: '42%' },
  },
  {
    title: t(lang, 'tutos.tailscale.step2.title'),
    content: t(lang, 'tutos.tailscale.win.step2.content'),
    link: { url: 'https://tailscale.com/download', label: t(lang, 'tutos.tailscale.win.step2.linkLabel') },
    image: { src: '/images/tutos/tailscale/tailscale-download.png', alt: 'Tailscale download page' },
    content2: t(lang, 'tutos.tailscale.win.step2.connectedNote'),
    image2: { src: '/images/tutos/tailscale/tailscale-connected-pc.png', alt: 'Tailscale connected in system tray', maxWidth: '49%' },
  },
  {
    title: t(lang, 'tutos.tailscale.step3.title'),
    content: t(lang, 'tutos.tailscale.step3.content'),
    storeBadges: true,
    image: { src: '/images/tutos/tailscale/tailscale-playstore.png', alt: 'Tailscale on Google Play Store', maxWidth: '35%' },
  },
  {
    title: t(lang, 'tutos.tailscale.step4.title'),
    content: t(lang, 'tutos.tailscale.step4.content'),
    code: t(lang, 'tutos.tailscale.step4.code'),
    image: { src: '/images/tutos/tailscale/tailscale-dashboard.png', alt: 'Tailscale web dashboard', maxWidth: '66%' },
  },
];

const linux = [
  {
    title: t(lang, 'tutos.tailscale.step1.title'),
    content: t(lang, 'tutos.tailscale.step1.content'),
    link: { url: 'https://login.tailscale.com/login?next_url=%2Fwelcome', label: t(lang, 'tutos.tailscale.step1.linkLabel') },
    image: { src: '/images/tutos/tailscale/tailscale-login.png', alt: 'Tailscale login page', maxWidth: '42%' },
  },
  {
    title: t(lang, 'tutos.tailscale.step2.title'),
    code: t(lang, 'tutos.tailscale.linux.step2.code'),
  },
  {
    title: t(lang, 'tutos.tailscale.step3.title'),
    content: t(lang, 'tutos.tailscale.step3.content'),
    storeBadges: true,
    image: { src: '/images/tutos/tailscale/tailscale-playstore.png', alt: 'Tailscale on Google Play Store', maxWidth: '35%' },
  },
  {
    title: t(lang, 'tutos.tailscale.step4.title'),
    content: t(lang, 'tutos.tailscale.step4.content'),
    code: t(lang, 'tutos.tailscale.step4.code'),
    image: { src: '/images/tutos/tailscale/tailscale-dashboard.png', alt: 'Tailscale web dashboard', maxWidth: '66%' },
  },
];

const mac = [
  {
    title: t(lang, 'tutos.tailscale.step1.title'),
    content: t(lang, 'tutos.tailscale.step1.content'),
    link: { url: 'https://login.tailscale.com/login?next_url=%2Fwelcome', label: t(lang, 'tutos.tailscale.step1.linkLabel') },
    image: { src: '/images/tutos/tailscale/tailscale-login.png', alt: 'Tailscale login page', maxWidth: '42%' },
  },
  {
    title: t(lang, 'tutos.tailscale.step2.title'),
    content: t(lang, 'tutos.tailscale.mac.step2.content'),
    link: { url: 'https://tailscale.com/download', label: t(lang, 'tutos.tailscale.win.step2.linkLabel') },
    image: { src: '/images/tutos/tailscale/tailscale-download.png', alt: 'Tailscale download page' },
  },
  {
    title: t(lang, 'tutos.tailscale.step3.title'),
    content: t(lang, 'tutos.tailscale.step3.content'),
    storeBadges: true,
    image: { src: '/images/tutos/tailscale/tailscale-playstore.png', alt: 'Tailscale on Google Play Store', maxWidth: '35%' },
  },
  {
    title: t(lang, 'tutos.tailscale.step4.title'),
    content: t(lang, 'tutos.tailscale.step4.content'),
    code: t(lang, 'tutos.tailscale.step4.code'),
    image: { src: '/images/tutos/tailscale/tailscale-dashboard.png', alt: 'Tailscale web dashboard', maxWidth: '66%' },
  },
];
---

<TutoLayout
  title={t(lang, 'tutos.tailscale.title')}
  intro={t(lang, 'tutos.tailscale.intro')}
  description="Set up Tailscale VPN to connect to your PC from anywhere with Chill. No port forwarding required — works over WiFi, 5G, and abroad."
  showChillCta
  howToSteps={[
    { name: t(lang, 'tutos.tailscale.step1.title'), text: t(lang, 'tutos.tailscale.step1.content') },
    { name: t(lang, 'tutos.tailscale.step2.title'), text: t(lang, 'tutos.tailscale.win.step2.content') },
    { name: t(lang, 'tutos.tailscale.step3.title'), text: t(lang, 'tutos.tailscale.step3.content') },
    { name: t(lang, 'tutos.tailscale.step4.title'), text: t(lang, 'tutos.tailscale.step4.content') },
  ]}
  breadcrumbs={[
    { name: 'Home', url: 'https://chill.app/' },
    { name: 'Tutorials', url: 'https://chill.app/tutos' },
    { name: t(lang, 'tutos.tailscale.title'), url: 'https://chill.app/tutos/tailscale' },
  ]}
>
  <TailscaleContent client:visible win={win} linux={linux} mac={mac} />

  <!-- Related tutorials -->
  <div data-animate="100" class="mt-10 rounded-chill border border-chill-border bg-chill-elevated p-5">
    <h3 class="text-body-sm font-heading font-semibold text-chill-text mb-3">Related</h3>
    <div class="flex flex-wrap gap-3">
      <a href="/tutos/config-os" class="text-body-sm text-chill-accent hover:underline">OS Setup &rarr;</a>
      <a href="/tutos/ssh" class="text-body-sm text-chill-accent hover:underline">SSH Connection &rarr;</a>
      <a href="/tutos/agents-cli" class="text-body-sm text-chill-accent hover:underline">CLI Agents &rarr;</a>
    </div>
  </div>
</TutoLayout>
