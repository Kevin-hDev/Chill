---
import TutoLayout from '../../components/tutos/TutoLayout.astro';
import BiosAsusContent from '../../components/tutos/BiosAsusContent.tsx';
import { getLangFromUrl, t } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const asusSteps = [
  { text: t(lang, 'tutos.bios.asus.step1') },
  {
    text: t(lang, 'tutos.bios.asus.step2'),
    image: { src: '/images/tutos/bios/bios-1-advanced-apm.jpg', alt: 'BIOS Advanced > APM Configuration' },
  },
  {
    text: t(lang, 'tutos.bios.asus.step3'),
    image: { src: '/images/tutos/bios/bios-3-apm-settings.jpg', alt: 'APM Configuration settings' },
  },
  {
    text: t(lang, 'tutos.bios.asus.step4'),
    image: { src: '/images/tutos/bios/bios-2-advanced-platform-misc.jpg', alt: 'BIOS Advanced > Platform Misc Configuration' },
  },
  {
    text: t(lang, 'tutos.bios.asus.step5'),
    image: { src: '/images/tutos/bios/bios-4-native-aspm.jpg', alt: 'Native ASPM Disabled' },
  },
  { text: t(lang, 'tutos.bios.asus.step6') },
];
---

<TutoLayout
  title={t(lang, 'tutos.bios.title')}
  intro={t(lang, 'tutos.bios.intro')}
  description="Configure BIOS settings for Wake-on-LAN. Enable Power On By PCI-E, disable ErP Ready and Native ASPM on ASUS/ROG motherboards."
  showOsTabs={false}
  howToSteps={[
    { name: t(lang, 'tutos.bios.asus.step1'), text: t(lang, 'tutos.bios.asus.step1') },
    { name: t(lang, 'tutos.bios.asus.step2'), text: t(lang, 'tutos.bios.asus.step2') },
    { name: t(lang, 'tutos.bios.asus.step3'), text: t(lang, 'tutos.bios.asus.step3') },
    { name: t(lang, 'tutos.bios.asus.step4'), text: t(lang, 'tutos.bios.asus.step4') },
    { name: t(lang, 'tutos.bios.asus.step5'), text: t(lang, 'tutos.bios.asus.step5') },
    { name: t(lang, 'tutos.bios.asus.step6'), text: t(lang, 'tutos.bios.asus.step6') },
  ]}
  breadcrumbs={[
    { name: 'Home', url: 'https://chill.app/' },
    { name: 'Tutorials', url: 'https://chill.app/tutos' },
    { name: t(lang, 'tutos.bios.title'), url: 'https://chill.app/tutos/bios' },
  ]}
>
  <!-- Generic: what to look for -->
  <div data-animate="0" class="mb-8 rounded-chill border border-chill-border bg-chill-elevated p-6">
    <h2 class="text-h3 font-heading font-bold text-chill-text mb-3">
      {t(lang, 'tutos.bios.generic.title')}
    </h2>
    <p class="text-body-sm text-chill-text-secondary leading-relaxed whitespace-pre-line">
      {t(lang, 'tutos.bios.generic.content')}
    </p>
  </div>

  <!-- ASUS/ROG guide -->
  <div data-animate="150">
    <h2 class="text-h3 font-heading font-bold text-chill-text mb-3">
      {t(lang, 'tutos.bios.asus.title')}
    </h2>
    <div class="rounded-chill border border-chill-border bg-chill-elevated p-4">
      <BiosAsusContent
        warning={t(lang, 'tutos.bios.asus.warning')}
        steps={asusSteps}
      />
    </div>
  </div>

  <!-- Related tutorials -->
  <div data-animate="100" class="mt-10 rounded-chill border border-chill-border bg-chill-elevated p-5">
    <h3 class="text-body-sm font-heading font-semibold text-chill-text mb-3">Next steps</h3>
    <div class="flex flex-wrap gap-3">
      <a href="/tutos/wol" class="text-body-sm text-chill-accent hover:underline">Wake-on-LAN &rarr;</a>
      <a href="/tutos/config-os" class="text-body-sm text-chill-accent hover:underline">OS Setup &rarr;</a>
    </div>
  </div>
</TutoLayout>
