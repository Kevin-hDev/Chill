---
import TutoLayout from '../../components/tutos/TutoLayout.astro';
import SshContent from '../../components/tutos/SshContent.tsx';
import { getLangFromUrl, t } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const win = [
  {
    title: t(lang, 'tutos.ssh.step1.title'),
    code: t(lang, 'tutos.ssh.win.step1.code'),
  },
  {
    title: t(lang, 'tutos.ssh.step2.title'),
    content: t(lang, 'tutos.ssh.step2.content'),
    code: t(lang, 'tutos.ssh.step2.code'),
  },
  {
    title: t(lang, 'tutos.ssh.step3.title'),
    content: t(lang, 'tutos.ssh.step3.content'),
    extra: [
      {
        label: t(lang, 'tutos.ssh.win.step3.admin'),
        code: t(lang, 'tutos.ssh.win.step3.adminCode'),
      },
      {
        label: t(lang, 'tutos.ssh.win.step3.standard'),
        code: t(lang, 'tutos.ssh.win.step3.standardCode'),
      },
    ],
  },
];

const linux = [
  {
    title: t(lang, 'tutos.ssh.step1.title'),
    code: t(lang, 'tutos.ssh.linux.step1.code'),
  },
  {
    title: t(lang, 'tutos.ssh.step2.title'),
    content: t(lang, 'tutos.ssh.step2.content'),
    code: t(lang, 'tutos.ssh.step2.code'),
  },
  {
    title: t(lang, 'tutos.ssh.step3.title'),
    content: t(lang, 'tutos.ssh.step3.content'),
    code: t(lang, 'tutos.ssh.linux.step3.code'),
  },
];

const mac = [
  {
    title: t(lang, 'tutos.ssh.step1.title'),
    code: t(lang, 'tutos.ssh.mac.step1.code'),
  },
  {
    title: t(lang, 'tutos.ssh.step2.title'),
    content: t(lang, 'tutos.ssh.step2.content'),
    code: t(lang, 'tutos.ssh.step2.code'),
  },
  {
    title: t(lang, 'tutos.ssh.step3.title'),
    content: t(lang, 'tutos.ssh.step3.content'),
    code: t(lang, 'tutos.ssh.mac.step3.code'),
  },
];
---

<TutoLayout
  title={t(lang, 'tutos.ssh.title')}
  intro={t(lang, 'tutos.ssh.intro')}
  description="How to connect to your PC via SSH from your phone with Chill. Find your IP, test the connection, and set up Ed25519 keys."
  showChillCta
  howToSteps={[
    { name: t(lang, 'tutos.ssh.step1.title'), text: t(lang, 'tutos.ssh.win.step1.code') },
    { name: t(lang, 'tutos.ssh.step2.title'), text: t(lang, 'tutos.ssh.step2.content') },
    { name: t(lang, 'tutos.ssh.step3.title'), text: t(lang, 'tutos.ssh.step3.content') },
  ]}
  breadcrumbs={[
    { name: 'Home', url: 'https://chill.app/' },
    { name: 'Tutorials', url: 'https://chill.app/tutos' },
    { name: t(lang, 'tutos.ssh.title'), url: 'https://chill.app/tutos/ssh' },
  ]}
>
  <SshContent client:visible win={win} linux={linux} mac={mac} />

  <!-- SSH info -->
  <div data-animate="50" class="mt-10 space-y-6">
    <div class="rounded-chill border border-chill-border bg-chill-elevated p-5">
      <h2 class="text-h3 font-heading font-semibold text-chill-text mb-3">What is SSH?</h2>
      <p class="text-body-sm text-chill-text-secondary leading-relaxed mb-3">
        SSH (Secure Shell) is the standard protocol for secure remote access, used by millions of developers and system administrators worldwide. It creates an encrypted tunnel between your phone and your PC, protecting all data in transit — commands, files, and credentials.
      </p>
      <p class="text-body-sm text-chill-text-secondary leading-relaxed">
        ChillShell uses Ed25519 keys for authentication, the algorithm recommended by the OpenSSH project. Ed25519 provides 256-bit security with compact key sizes, making it both faster and more secure than older RSA keys. Key-based authentication eliminates the risk of password brute-force attacks.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="rounded-chill border border-chill-border bg-chill-elevated p-4 text-center">
        <p class="text-h3 font-heading font-bold text-chill-accent">256-bit</p>
        <p class="text-micro text-chill-text-muted">Ed25519 encryption</p>
      </div>
      <div class="rounded-chill border border-chill-border bg-chill-elevated p-4 text-center">
        <p class="text-h3 font-heading font-bold text-chill-accent">&lt; 2 min</p>
        <p class="text-micro text-chill-text-muted">Setup time</p>
      </div>
      <div class="rounded-chill border border-chill-border bg-chill-elevated p-4 text-center">
        <p class="text-h3 font-heading font-bold text-chill-accent">0 data</p>
        <p class="text-micro text-chill-text-muted">Sent to our servers</p>
      </div>
    </div>

    <div class="rounded-chill border border-chill-border bg-chill-elevated p-5">
      <h2 class="text-h3 font-heading font-semibold text-chill-text mb-3">Tips</h2>
      <ul class="space-y-2 text-body-sm text-chill-text-secondary">
        <li class="flex items-start gap-2">
          <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-chill-accent"></span>
          Use key-based authentication instead of passwords for better security and faster connections.
        </li>
        <li class="flex items-start gap-2">
          <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-chill-accent"></span>
          Your local IP address may change if your router restarts. Consider assigning a static IP or using Tailscale for a permanent address.
        </li>
        <li class="flex items-start gap-2">
          <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-chill-accent"></span>
          SSH only works on your local network by default. To connect from anywhere, set up Tailscale VPN — it takes under 2 minutes.
        </li>
      </ul>
    </div>
  </div>

  <!-- Related tutorials -->
  <div data-animate="100" class="mt-10 rounded-chill border border-chill-border bg-chill-elevated p-5">
    <h3 class="text-body-sm font-heading font-semibold text-chill-text mb-3">Next steps</h3>
    <div class="flex flex-wrap gap-3">
      <a href="/tutos/tailscale" class="text-body-sm text-chill-accent hover:underline">Tailscale VPN — Access your PC from anywhere &rarr;</a>
      <a href="/tutos/wol" class="text-body-sm text-chill-accent hover:underline">Wake-on-LAN — Power on your PC remotely &rarr;</a>
      <a href="/tutos/agents-cli" class="text-body-sm text-chill-accent hover:underline">CLI Agents — Run AI agents via SSH &rarr;</a>
    </div>
  </div>
</TutoLayout>
