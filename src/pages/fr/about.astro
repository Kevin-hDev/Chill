---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, t } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
---

<BaseLayout title={t(lang, 'about.pageTitle')} description={t(lang, 'about.description')}>
  <section class="py-12 md:py-[var(--spacing-section)]">
    <h1 data-animate="0" class="text-hero-h1 font-heading font-bold text-chill-text mb-12">
      {t(lang, 'about.title')}
    </h1>

    <div class="space-y-10">
      <!-- Mission -->
      <div data-animate="100" class="rounded-chill border border-chill-border bg-chill-elevated p-6">
        <h2 class="text-h3 font-heading font-semibold text-chill-text mb-3">
          {t(lang, 'about.mission.title')}
        </h2>
        <p class="text-body-sm text-chill-text-secondary leading-relaxed">
          {t(lang, 'about.mission.content')}
        </p>
      </div>

      <!-- Story -->
      <div data-animate="200" class="rounded-chill border border-chill-border bg-chill-elevated p-6">
        <h2 class="text-h3 font-heading font-semibold text-chill-text mb-3">
          {t(lang, 'about.story.title')}
        </h2>
        <p class="text-body-sm text-chill-text-secondary leading-relaxed">
          {t(lang, 'about.story.content')}
        </p>
      </div>

      <!-- Values -->
      <div data-animate="300">
        <h2 class="text-h3 font-heading font-semibold text-chill-text mb-6">
          {t(lang, 'about.values.title')}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          <!-- Security -->
          <div class="rounded-chill border border-chill-border bg-chill-elevated p-6">
            <div class="flex items-center gap-3 mb-3">
              <svg class="w-6 h-6 shrink-0 text-chill-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              </svg>
              <h3 class="text-body-sm font-heading font-semibold text-chill-text">
                {t(lang, 'about.values.security')}
              </h3>
            </div>
            <p class="text-body-sm text-chill-text-secondary leading-relaxed">
              {t(lang, 'about.values.securityDesc')}
            </p>
          </div>

          <!-- Privacy -->
          <div class="rounded-chill border border-chill-border bg-chill-elevated p-6">
            <div class="flex items-center gap-3 mb-3">
              <svg class="w-6 h-6 shrink-0 text-chill-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
              </svg>
              <h3 class="text-body-sm font-heading font-semibold text-chill-text">
                {t(lang, 'about.values.privacy')}
              </h3>
            </div>
            <p class="text-body-sm text-chill-text-secondary leading-relaxed">
              {t(lang, 'about.values.privacyDesc')}
            </p>
          </div>

          <!-- Transparency -->
          <div class="rounded-chill border border-chill-border bg-chill-elevated p-6">
            <div class="flex items-center gap-3 mb-3">
              <svg class="w-6 h-6 shrink-0 text-chill-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="16" x2="12" y2="12" />
                <line x1="12" y1="8" x2="12.01" y2="8" />
              </svg>
              <h3 class="text-body-sm font-heading font-semibold text-chill-text">
                {t(lang, 'about.values.transparency')}
              </h3>
            </div>
            <p class="text-body-sm text-chill-text-secondary leading-relaxed">
              {t(lang, 'about.values.transparencyDesc')}
            </p>
          </div>
        </div>
      </div>

      <!-- Developer -->
      <div data-animate="400" class="rounded-chill border border-chill-border bg-chill-elevated p-6">
        <h2 class="text-h3 font-heading font-semibold text-chill-text mb-3">
          {t(lang, 'about.dev.title')}
        </h2>
        <p class="text-body-sm text-chill-text-secondary leading-relaxed">
          {t(lang, 'about.dev.content')}
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
