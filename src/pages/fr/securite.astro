<script>
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = btn.getAttribute('data-tab');
      document.querySelectorAll('[data-tab-content]').forEach(el => {
        el.classList.toggle('hidden', el.getAttribute('data-tab-content') !== tab);
      });
      document.querySelectorAll('.tab-btn').forEach(b => {
        const isActive = b.getAttribute('data-tab') === tab;
        b.setAttribute('aria-selected', String(isActive));
        if (isActive) {
          b.classList.add('bg-chill-accent', 'text-white');
          b.classList.remove('border', 'border-chill-border', 'text-chill-text-secondary');
        } else {
          b.classList.remove('bg-chill-accent', 'text-white');
          b.classList.add('border', 'border-chill-border', 'text-chill-text-secondary');
        }
      });
    });
  });
</script>
