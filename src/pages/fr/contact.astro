---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, t } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
---

<BaseLayout title={t(lang, 'contact.pageTitle')} description={t(lang, 'contact.description')}>
  <section class="py-12 md:py-[var(--spacing-section)]">
    <h1 data-animate="0" class="text-hero-h1 font-heading font-bold text-chill-text mb-4">
      {t(lang, 'contact.title')}
    </h1>
    <p data-animate="50" class="text-body-sm text-chill-text-secondary mb-12">
      {t(lang, 'contact.intro')}
    </p>

    <div class="space-y-10">
      <!-- Email -->
      <div data-animate="100" class="rounded-chill border border-chill-border bg-chill-elevated p-6">
        <div class="flex items-center gap-3 mb-3">
          <svg class="w-6 h-6 shrink-0 text-chill-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
            <polyline points="22,6 12,13 2,6" />
          </svg>
          <h2 class="text-h3 font-heading font-semibold text-chill-text">
            {t(lang, 'contact.email.title')}
          </h2>
        </div>
        <p class="text-body-sm text-chill-text-secondary leading-relaxed mb-3">
          {t(lang, 'contact.email.content')}
        </p>
        <a href="mailto:chill_app@outlook.fr" class="text-body-sm text-chill-accent hover:text-chill-accent-hover transition-colors font-mono">
          chill_app@outlook.fr
        </a>
      </div>

      <!-- GitHub -->
      <div data-animate="200" class="rounded-chill border border-chill-border bg-chill-elevated p-6">
        <div class="flex items-center gap-3 mb-3">
          <svg class="w-6 h-6 shrink-0 text-chill-accent" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <h2 class="text-h3 font-heading font-semibold text-chill-text">
            {t(lang, 'contact.stores.title')}
          </h2>
        </div>
        <p class="text-body-sm text-chill-text-secondary leading-relaxed mb-4">
          {t(lang, 'contact.stores.content')}
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="https://github.com/Kevin-hDev" target="_blank" rel="noopener noreferrer" class="inline-block hover:opacity-80 transition-opacity">
            <img src="/images/icons_github.png" alt="GitHub" width="67" height="67" class="h-[67px] w-auto" />
          </a>
        </div>
      </div>

      <!-- Response time -->
      <div data-animate="300" class="rounded-chill border border-chill-border bg-chill-elevated p-6">
        <div class="flex items-center gap-3 mb-3">
          <svg class="w-6 h-6 shrink-0 text-chill-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
          </svg>
          <h2 class="text-h3 font-heading font-semibold text-chill-text">
            {t(lang, 'contact.response.title')}
          </h2>
        </div>
        <p class="text-body-sm text-chill-text-secondary leading-relaxed">
          {t(lang, 'contact.response.content')}
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
