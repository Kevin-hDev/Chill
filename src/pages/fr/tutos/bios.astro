---
import TutoLayout from '../../../components/tutos/TutoLayout.astro';
import Accordion from '../../../components/ui/Accordion.tsx';
import { getLangFromUrl, t } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
---

<TutoLayout title={t(lang, 'tutos.bios.title')} intro={t(lang, 'tutos.bios.intro')} showOsTabs={false}>
  <!-- Generic: what to look for -->
  <div data-animate="0" class="mb-8 rounded-chill border border-chill-border bg-chill-elevated p-6">
    <h2 class="text-h3 font-heading font-bold text-chill-text mb-3">
      {t(lang, 'tutos.bios.generic.title')}
    </h2>
    <p class="text-body-sm text-chill-text-secondary leading-relaxed whitespace-pre-line">
      {t(lang, 'tutos.bios.generic.content')}
    </p>
  </div>

  <!-- Brand accordions -->
  <div data-animate="150" class="space-y-4">
    <Accordion client:visible title={t(lang, 'tutos.bios.asus.title')} defaultOpen>
      <p class="whitespace-pre-line leading-relaxed">
        {t(lang, 'tutos.bios.asus.content')}
      </p>
    </Accordion>
  </div>
</TutoLayout>
