---
import TutoLayout from '../../../components/tutos/TutoLayout.astro';
import CompatTable from '../../../components/tutos/CompatTable.tsx';
import AgentCard from '../../../components/tutos/AgentCard.tsx';
import { getLangFromUrl, t } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const tabLabels = {
  install: t(lang, 'tutos.agents.installTab'),
  run: t(lang, 'tutos.agents.runTab'),
  upgrade: t(lang, 'tutos.agents.upgradeTab'),
};

const statusLabels = {
  ok: t(lang, 'tutos.agents.status.ok'),
  bug: t(lang, 'tutos.agents.status.bug'),
  testing: t(lang, 'tutos.agents.status.testing'),
};

const agents = [
  {
    name: 'Claude Code',
    description: 'Agent CLI d\'Anthropic pour les tâches de développement.',
    prereqs: 'Node.js 18+',
    installCode: 'npm install -g @anthropic-ai/claude-code',
    runCode: 'claude',
    upgradeCode: 'npm update -g @anthropic-ai/claude-code',
  },
  {
    name: 'Codex CLI',
    description: 'Agent CLI d\'OpenAI pour la génération de code.',
    prereqs: 'Node.js 22+',
    installCode: 'npm install -g @openai/codex',
    runCode: 'codex',
    upgradeCode: 'npm update -g @openai/codex',
  },
  {
    name: 'Cursor CLI',
    description: 'Agent de développement Cursor en terminal.',
    prereqs: 'Node.js 18+',
    installCode: 'npm install -g @anthropic-ai/cursor-cli',
    runCode: 'cursor-cli',
    upgradeCode: 'npm update -g @anthropic-ai/cursor-cli',
  },
  {
    name: 'Kimi Code',
    description: 'Assistant CLI de Moonshot AI pour le code.',
    prereqs: 'Node.js 18+',
    installCode: 'npm install -g kimi-code',
    runCode: 'kimi',
    upgradeCode: 'npm update -g kimi-code',
  },
  {
    name: 'Gemini CLI',
    description: 'Agent CLI de Google propulsé par Gemini.',
    prereqs: 'Node.js 18+',
    installCode: 'npm install -g @anthropic-ai/gemini-cli',
    runCode: 'gemini',
    upgradeCode: 'npm update -g @anthropic-ai/gemini-cli',
  },
  {
    name: 'Droid CLI',
    description: 'Agent CLI léger pour des tâches rapides.',
    prereqs: 'Node.js 18+',
    installCode: 'npm install -g droid-cli',
    runCode: 'droid',
    upgradeCode: 'npm update -g droid-cli',
  },
  {
    name: 'Mistral Vibe',
    description: 'Agent de vibe coding par Mistral AI.',
    prereqs: 'Python 3.10+',
    installCode: 'pip install mistral-vibe',
    runCode: 'mistral-vibe',
    upgradeCode: 'pip install --upgrade mistral-vibe',
  },
  {
    name: 'Crush',
    description: 'Agent CLI expérimental — détails à venir.',
    installCode: 'TBD',
    runCode: 'TBD',
    upgradeCode: 'TBD',
  },
  {
    name: 'Grok CLI',
    description: 'Agent CLI de xAI propulsé par Grok.',
    prereqs: 'Node.js 18+',
    installCode: 'npm install -g grok-cli',
    runCode: 'grok',
    upgradeCode: 'npm update -g grok-cli',
  },
  {
    name: 'OpenCode',
    description: 'Agent CLI open-source écrit en Go.',
    prereqs: 'Go 1.21+',
    installCode: 'go install github.com/opencode-ai/opencode@latest',
    runCode: 'opencode',
    upgradeCode: 'go install github.com/opencode-ai/opencode@latest',
  },
];
---

<TutoLayout
  title={t(lang, 'tutos.agents.title')}
  intro={t(lang, 'tutos.agents.intro')}
  description="Coder depuis votre téléphone avec des agents IA via SSH. Claude Code, Gemini CLI, Codex — vibe coding mobile gratuit avec ChillShell. Guide et compatibilité."
  showOsTabs={false}
  breadcrumbs={[
    { name: 'Accueil', url: 'https://chill.app/fr/' },
    { name: 'Tutoriels', url: 'https://chill.app/fr/tutos' },
    { name: t(lang, 'tutos.agents.title'), url: 'https://chill.app/fr/tutos/agents-cli' },
  ]}
>
  <!-- Intro vibe coding -->
  <div data-animate="0" class="mb-10 space-y-6">
    <div class="rounded-chill border border-chill-border bg-chill-elevated p-5">
      <h2 class="text-h3 font-heading font-semibold text-chill-text mb-3">Code depuis ton téléphone</h2>
      <p class="text-body-sm text-chill-text-secondary leading-relaxed mb-3">
        Le vibe coding change la façon dont les développeurs travaillent. Avec ChillShell, tu peux lancer n'importe quel agent IA en ligne de commande directement depuis ton téléphone via SSH — Claude Code, Codex CLI, Gemini, Cursor et plus. Pas besoin de laptop. Ouvre ChillShell, connecte-toi à ton PC et commence à coder de n'importe où.
      </p>
      <p class="text-body-sm text-chill-text-secondary leading-relaxed">
        Tout ce qu'il te faut, c'est une connexion SSH vers ton ordinateur (réseau local ou via le VPN Tailscale pour l'accès distant). L'agent IA tourne sur le matériel de ton PC avec un accès complet à ta base de code, pendant que tu contrôles tout depuis le terminal de ton téléphone. Ton code reste sur ta machine — rien ne passe par les serveurs de ChillShell.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="rounded-chill border border-chill-border bg-chill-elevated p-4 text-center">
        <p class="text-h3 font-heading font-bold text-chill-accent">10+</p>
        <p class="text-micro text-chill-text-muted">Agents CLI supportés</p>
      </div>
      <div class="rounded-chill border border-chill-border bg-chill-elevated p-4 text-center">
        <p class="text-h3 font-heading font-bold text-chill-accent">SSH</p>
        <p class="text-micro text-chill-text-muted">Connexion sécurisée</p>
      </div>
      <div class="rounded-chill border border-chill-border bg-chill-elevated p-4 text-center">
        <p class="text-h3 font-heading font-bold text-chill-accent">Gratuit</p>
        <p class="text-micro text-chill-text-muted">Sans abonnement</p>
      </div>
    </div>

    <div class="rounded-chill border border-chill-border bg-chill-elevated p-5">
      <h2 class="text-h3 font-heading font-semibold text-chill-text mb-3">Comment ça marche</h2>
      <ol class="space-y-2 text-body-sm text-chill-text-secondary list-decimal list-inside">
        <li>Configure SSH sur ton PC (<a href="/fr/tutos/config-os" class="text-chill-accent hover:underline">Guide Config OS</a>)</li>
        <li>Installe l'agent IA de ton choix sur ton PC (voir les commandes ci-dessous)</li>
        <li>Connecte-toi via ChillShell depuis ton téléphone (<a href="/fr/tutos/ssh" class="text-chill-accent hover:underline">Guide SSH</a>)</li>
        <li>Lance la commande de l'agent — il utilise toute la puissance de ton PC</li>
      </ol>
      <p class="text-body-sm text-chill-text-muted mt-3 italic">
        Pour l'accès distant hors de ton réseau local, configure d'abord le <a href="/fr/tutos/tailscale" class="text-chill-accent hover:underline">VPN Tailscale</a>.
      </p>
    </div>
  </div>

  <!-- Tableau de compatibilité -->
  <div data-animate="0" class="mb-10">
    <h2 class="text-h3 font-heading font-bold text-chill-text mb-4">
      {t(lang, 'tutos.agents.compat')}
    </h2>
    <CompatTable client:visible statusLabels={statusLabels} />
  </div>

  <!-- Grille de cartes agents -->
  <div data-animate="200" class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {agents.map((agent) => (
      <AgentCard
        client:visible
        name={agent.name}
        description={agent.description}
        prereqs={agent.prereqs}
        installCode={agent.installCode}
        runCode={agent.runCode}
        upgradeCode={agent.upgradeCode}
        tabLabels={tabLabels}
      />
    ))}
  </div>

  <!-- Cas d'utilisation -->
  <div data-animate="100" class="mt-10 rounded-chill border border-chill-border bg-chill-elevated p-5">
    <h2 class="text-h3 font-heading font-semibold text-chill-text mb-3">Qu'est-ce que tu peux faire ?</h2>
    <ul class="space-y-2 text-body-sm text-chill-text-secondary">
      <li class="flex items-start gap-2">
        <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-chill-accent"></span>
        Demande à Claude Code d'implémenter des fonctionnalités, corriger des bugs ou refactoriser du code — le tout depuis ton téléphone
      </li>
      <li class="flex items-start gap-2">
        <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-chill-accent"></span>
        Génère du code boilerplate, des tests ou de la documentation avec Codex CLI pendant tes trajets
      </li>
      <li class="flex items-start gap-2">
        <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-chill-accent"></span>
        Lance des revues de code et obtiens des suggestions d'amélioration avec Gemini CLI
      </li>
      <li class="flex items-start gap-2">
        <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-chill-accent"></span>
        Surveille les tâches longues des agents — vérifie la progression, approuve les changements, itère
      </li>
    </ul>
  </div>

  <!-- Tutoriels associés -->
  <div data-animate="100" class="mt-10 rounded-chill border border-chill-border bg-chill-elevated p-5">
    <h3 class="text-body-sm font-heading font-semibold text-chill-text mb-3">Prérequis</h3>
    <div class="flex flex-wrap gap-3">
      <a href="/fr/tutos/config-os" class="text-body-sm text-chill-accent hover:underline">Config OS — Activer SSH sur ton PC &rarr;</a>
      <a href="/fr/tutos/ssh" class="text-body-sm text-chill-accent hover:underline">Connexion SSH — Se connecter depuis ton téléphone &rarr;</a>
      <a href="/fr/tutos/tailscale" class="text-body-sm text-chill-accent hover:underline">VPN Tailscale — Accéder de n'importe où &rarr;</a>
    </div>
  </div>
</TutoLayout>
