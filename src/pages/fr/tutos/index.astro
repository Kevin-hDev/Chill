---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SchemaBreadcrumb from '../../../components/seo/SchemaBreadcrumb.astro';
import { getLangFromUrl, t, getLocalePath } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const tutorials = [
  {
    title: t(lang, 'tutos.configOs.title'),
    description: 'Activer SSH sur Windows, Linux et macOS pour que ton téléphone puisse se connecter à ton PC.',
    href: '/fr/tutos/config-os',
    icon: '⚙️',
  },
  {
    title: t(lang, 'tutos.ssh.title'),
    description: 'Trouver ton adresse IP, tester SSH et configurer l\'authentification par clé Ed25519.',
    href: '/fr/tutos/ssh',
    icon: '🔑',
  },
  {
    title: t(lang, 'tutos.tailscale.title'),
    description: 'Configurer le VPN Tailscale pour accéder à ton PC de partout — sans redirection de port.',
    href: '/fr/tutos/tailscale',
    icon: '🌐',
  },
  {
    title: t(lang, 'tutos.bios.title'),
    description: 'Configurer le BIOS pour le Wake-on-LAN sur les cartes mères ASUS/ROG et autres.',
    href: '/fr/tutos/bios',
    icon: '🖥️',
  },
  {
    title: t(lang, 'tutos.wol.title'),
    description: 'Allumer ton PC à distance en envoyant un paquet magique sur le réseau.',
    href: '/fr/tutos/wol',
    icon: '⚡',
  },
  {
    title: t(lang, 'tutos.agents.title'),
    description: 'Lancer des agents IA comme Claude Code, Gemini CLI et Codex depuis ton téléphone.',
    href: '/fr/tutos/agents-cli',
    icon: '🤖',
  },
];
---

<BaseLayout title="Tutoriels — Guides de Configuration Chill & ChillShell" description="Guides étape par étape pour configurer SSH, VPN Tailscale, Wake-on-LAN, BIOS et agents IA avec ChillShell. Terminal SSH mobile gratuit.">
  <SchemaBreadcrumb items={[
    { name: 'Accueil', url: 'https://chill.app/fr/' },
    { name: 'Tutoriels', url: 'https://chill.app/fr/tutos' },
  ]} />

  <section class="mx-auto max-w-3xl px-4 py-16 sm:py-24">
    <div data-animate="0" class="mb-10 text-center">
      <h1 class="text-h1 font-heading font-bold text-chill-text mb-4">Tutoriels</h1>
      <p class="text-body text-chill-text-secondary max-w-xl mx-auto">
        Tout ce qu'il faut pour connecter ton téléphone à ton PC avec ChillShell. Suis les guides dans l'ordre ou va directement à ce dont tu as besoin.
      </p>
    </div>

    <div class="space-y-4">
      {tutorials.map((tuto, i) => (
        <a
          href={tuto.href}
          data-animate={String(i * 50)}
          class="block rounded-chill border border-chill-border bg-chill-elevated p-5 hover:border-chill-accent/50 transition-colors group"
        >
          <div class="flex items-start gap-4">
            <span class="text-2xl shrink-0 mt-0.5">{tuto.icon}</span>
            <div>
              <h2 class="text-body font-heading font-semibold text-chill-text group-hover:text-chill-accent transition-colors">
                {tuto.title}
              </h2>
              <p class="text-body-sm text-chill-text-secondary mt-1">{tuto.description}</p>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
