---
import TutoLayout from '../../../components/tutos/TutoLayout.astro';
import SshContent from '../../../components/tutos/SshContent.tsx';
import { getLangFromUrl, t } from '../../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const win = [
  {
    title: t(lang, 'tutos.ssh.step1.title'),
    code: t(lang, 'tutos.ssh.win.step1.code'),
  },
  {
    title: t(lang, 'tutos.ssh.step2.title'),
    content: t(lang, 'tutos.ssh.step2.content'),
    code: t(lang, 'tutos.ssh.step2.code'),
  },
  {
    title: t(lang, 'tutos.ssh.step3.title'),
    content: t(lang, 'tutos.ssh.step3.content'),
    extra: [
      {
        label: t(lang, 'tutos.ssh.win.step3.admin'),
        code: t(lang, 'tutos.ssh.win.step3.adminCode'),
      },
      {
        label: t(lang, 'tutos.ssh.win.step3.standard'),
        code: t(lang, 'tutos.ssh.win.step3.standardCode'),
      },
    ],
  },
];

const linux = [
  {
    title: t(lang, 'tutos.ssh.step1.title'),
    code: t(lang, 'tutos.ssh.linux.step1.code'),
  },
  {
    title: t(lang, 'tutos.ssh.step2.title'),
    content: t(lang, 'tutos.ssh.step2.content'),
    code: t(lang, 'tutos.ssh.step2.code'),
  },
  {
    title: t(lang, 'tutos.ssh.step3.title'),
    content: t(lang, 'tutos.ssh.step3.content'),
    code: t(lang, 'tutos.ssh.linux.step3.code'),
  },
];

const mac = [
  {
    title: t(lang, 'tutos.ssh.step1.title'),
    code: t(lang, 'tutos.ssh.mac.step1.code'),
  },
  {
    title: t(lang, 'tutos.ssh.step2.title'),
    content: t(lang, 'tutos.ssh.step2.content'),
    code: t(lang, 'tutos.ssh.step2.code'),
  },
  {
    title: t(lang, 'tutos.ssh.step3.title'),
    content: t(lang, 'tutos.ssh.step3.content'),
    code: t(lang, 'tutos.ssh.mac.step3.code'),
  },
];
---

<TutoLayout
  title={t(lang, 'tutos.ssh.title')}
  intro={t(lang, 'tutos.ssh.intro')}
  description="Se connecter en SSH à votre PC depuis votre téléphone avec un terminal SSH mobile gratuit. Trouvez votre IP, testez la connexion et configurez les clés Ed25519."
  showChillCta
  howToSteps={[
    { name: t(lang, 'tutos.ssh.step1.title'), text: t(lang, 'tutos.ssh.win.step1.code') },
    { name: t(lang, 'tutos.ssh.step2.title'), text: t(lang, 'tutos.ssh.step2.content') },
    { name: t(lang, 'tutos.ssh.step3.title'), text: t(lang, 'tutos.ssh.step3.content') },
  ]}
  breadcrumbs={[
    { name: 'Accueil', url: 'https://chill.app/fr/' },
    { name: 'Tutoriels', url: 'https://chill.app/fr/tutos' },
    { name: t(lang, 'tutos.ssh.title'), url: 'https://chill.app/fr/tutos/ssh' },
  ]}
>
  <SshContent client:visible win={win} linux={linux} mac={mac} />

  <!-- Infos SSH -->
  <div data-animate="50" class="mt-10 space-y-6">
    <div class="rounded-chill border border-chill-border bg-chill-elevated p-5">
      <h2 class="text-h3 font-heading font-semibold text-chill-text mb-3">C'est quoi SSH ?</h2>
      <p class="text-body-sm text-chill-text-secondary leading-relaxed mb-3">
        SSH (Secure Shell) est le protocole standard pour l'accès distant sécurisé, utilisé par des millions de développeurs et administrateurs système dans le monde. Il crée un tunnel chiffré entre ton téléphone et ton PC, protégeant toutes les données en transit — commandes, fichiers et identifiants.
      </p>
      <p class="text-body-sm text-chill-text-secondary leading-relaxed">
        ChillShell utilise des clés Ed25519 pour l'authentification, l'algorithme recommandé par le projet OpenSSH. Ed25519 offre une sécurité de 256 bits avec des tailles de clé compactes, le rendant à la fois plus rapide et plus sûr que les anciennes clés RSA. L'authentification par clé élimine le risque d'attaques par force brute sur les mots de passe.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="rounded-chill border border-chill-border bg-chill-elevated p-4 text-center">
        <p class="text-h3 font-heading font-bold text-chill-accent">256 bits</p>
        <p class="text-micro text-chill-text-muted">Chiffrement Ed25519</p>
      </div>
      <div class="rounded-chill border border-chill-border bg-chill-elevated p-4 text-center">
        <p class="text-h3 font-heading font-bold text-chill-accent">&lt; 2 min</p>
        <p class="text-micro text-chill-text-muted">Temps de configuration</p>
      </div>
      <div class="rounded-chill border border-chill-border bg-chill-elevated p-4 text-center">
        <p class="text-h3 font-heading font-bold text-chill-accent">0 donnée</p>
        <p class="text-micro text-chill-text-muted">Envoyée à nos serveurs</p>
      </div>
    </div>

    <div class="rounded-chill border border-chill-border bg-chill-elevated p-5">
      <h2 class="text-h3 font-heading font-semibold text-chill-text mb-3">Conseils</h2>
      <ul class="space-y-2 text-body-sm text-chill-text-secondary">
        <li class="flex items-start gap-2">
          <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-chill-accent"></span>
          Utilise l'authentification par clé plutôt que par mot de passe pour plus de sécurité et des connexions plus rapides.
        </li>
        <li class="flex items-start gap-2">
          <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-chill-accent"></span>
          Ton adresse IP locale peut changer si ton routeur redémarre. Pense à attribuer une IP fixe ou à utiliser Tailscale pour une adresse permanente.
        </li>
        <li class="flex items-start gap-2">
          <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-chill-accent"></span>
          SSH ne fonctionne que sur ton réseau local par défaut. Pour te connecter de partout, configure le VPN Tailscale — ça prend moins de 2 minutes.
        </li>
      </ul>
    </div>
  </div>

  <!-- Tutoriels associés -->
  <div data-animate="100" class="mt-10 rounded-chill border border-chill-border bg-chill-elevated p-5">
    <h3 class="text-body-sm font-heading font-semibold text-chill-text mb-3">Étapes suivantes</h3>
    <div class="flex flex-wrap gap-3">
      <a href="/fr/tutos/tailscale" class="text-body-sm text-chill-accent hover:underline">VPN Tailscale &rarr;</a>
      <a href="/fr/tutos/wol" class="text-body-sm text-chill-accent hover:underline">Wake-on-LAN &rarr;</a>
      <a href="/fr/tutos/agents-cli" class="text-body-sm text-chill-accent hover:underline">Agents CLI &rarr;</a>
    </div>
  </div>
</TutoLayout>
