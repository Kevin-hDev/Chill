---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaOrganization from '../../components/seo/SchemaOrganization.astro';
import SchemaSoftwareApp from '../../components/seo/SchemaSoftwareApp.astro';
import HeroChillShell from '../../components/home/HeroChillShell.tsx';
import SectionPerspective from '../../components/home/SectionPerspective.tsx';
import SectionFade from '../../components/home/SectionFade.tsx';
import Differentiator from '../../components/home/Differentiator.astro';
import Pricing from '../../components/home/Pricing.astro';
import { getLangFromUrl, t } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const terminalImages = [
  { src: '/images/screenshots/fr/dark/terminal-1.png', srcLight: '/images/screenshots/fr/light/terminal-1.png', alt: 'Vue terminal SSH' },
  { src: '/images/screenshots/fr/dark/terminal-2.png', srcLight: '/images/screenshots/fr/light/terminal-2.png', alt: 'Agent CLI en action' },
  { src: '/images/screenshots/fr/dark/terminal-3.png', srcLight: '/images/screenshots/fr/light/terminal-3.png', alt: 'Terminal multi-session' },
];

const connectionImages = [
  { src: '/images/screenshots/fr/dark/connect-1.png', srcLight: '/images/screenshots/fr/light/connect-1.png', alt: 'Tableau de bord connexion ChillShell' },
];

const customizeImages = [
  { src: '/images/screenshots/fr/dark/theme-1.png', srcLight: '/images/screenshots/fr/light/theme-1.png', alt: 'Réglages avec 12 thèmes de couleurs' },
  { src: '/images/screenshots/fr/dark/theme-2.png', srcLight: '/images/screenshots/fr/light/theme-2.png', alt: 'Écran de verrouillage PIN et empreinte' },
  { src: '/images/screenshots/fr/dark/theme-3.png', srcLight: '/images/screenshots/fr/light/theme-3.png', alt: 'VPN Tailscale et clés SSH' },
];
---

<BaseLayout title={t(lang, 'home.title')} description={t(lang, 'home.description')}>
  <SchemaOrganization />
  <SchemaSoftwareApp lang={lang} />

  <!-- Product Hero (ChillShell) -->
  <HeroChillShell
    client:visible
    tagline={t(lang, 'hero.tagline')}
    subtitle={t(lang, 'hero.subtitle')}
  />

  <hr class="section-divider" />

  <!-- Section 1: Terminal -->
  <SectionPerspective
    client:visible
    side="left"
    images={terminalImages}
    title={t(lang, 'sections.terminal.title')}
    description={t(lang, 'sections.terminal.description')}
  />

  <hr class="section-divider" />

  <!-- Section 2: Connexions -->
  <SectionFade
    client:visible
    images={connectionImages}
    title={t(lang, 'sections.connections.title')}
    description={t(lang, 'sections.connections.description')}
    side="right"
    aspectRatio="919/518"
    fadeBottomLeft
    diagonalText
  />

  <hr class="section-divider" />

  <!-- Section 3: Personnalisation (même orientation que Terminal) -->
  <SectionPerspective
    client:visible
    side="left"
    images={customizeImages}
    title={t(lang, 'sections.customize.title')}
    description={t(lang, 'sections.customize.description')}
  />

  <hr class="section-divider" />

  <!-- Différenciateur -->
  <Differentiator />

  <hr class="section-divider" />

  <!-- Tarifs -->
  <Pricing />
</BaseLayout>
