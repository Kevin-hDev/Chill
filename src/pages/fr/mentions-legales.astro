---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, t } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
---

<BaseLayout title={t(lang, 'legal.mentions.pageTitle')} description={t(lang, 'legal.mentions.description')}>
  <section class="py-[var(--spacing-section)]">
    <!-- Title -->
    <h1 data-animate="0" class="text-hero-h1 font-heading font-bold text-chill-text mb-12">
      {t(lang, 'legal.mentions.title')}
    </h1>

    <div data-animate="150" class="space-y-10">
      <!-- Editeur -->
      <div class="rounded-chill border border-chill-border bg-chill-elevated p-6">
        <h2 class="text-h3 font-heading font-semibold text-chill-text mb-3">
          {t(lang, 'legal.mentions.editor')}
        </h2>
        <p class="text-body-sm text-chill-text-secondary leading-relaxed">
          Chill App SAS<br />
          Paris, France<br />
          Directeur de la publication : Kevin Huynh
        </p>
      </div>

      <!-- Hebergeur -->
      <div class="rounded-chill border border-chill-border bg-chill-elevated p-6">
        <h2 class="text-h3 font-heading font-semibold text-chill-text mb-3">
          Hébergeur
        </h2>
        <p class="text-body-sm text-chill-text-secondary leading-relaxed">
          Vercel Inc.<br />
          440 N Barranca Ave #4133<br />
          Covina, CA 91723, United States<br />
          <a href="https://vercel.com" class="text-chill-accent hover:text-chill-accent-hover transition-colors">vercel.com</a>
        </p>
      </div>

      <!-- Contact -->
      <div class="rounded-chill border border-chill-border bg-chill-elevated p-6">
        <h2 class="text-h3 font-heading font-semibold text-chill-text mb-3">
          {t(lang, 'legal.mentions.contact')}
        </h2>
        <p class="text-body-sm text-chill-text-secondary leading-relaxed">
          Email : <a href="mailto:contact@chill.app" class="text-chill-accent hover:text-chill-accent-hover transition-colors">contact@chill.app</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
