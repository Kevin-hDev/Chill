---
import BaseLayout from '../layouts/BaseLayout.astro';
import SchemaArticle from '../components/seo/SchemaArticle.astro';
import AuthorDate from '../components/ui/AuthorDate.astro';
import { getLangFromUrl, t } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
---

<BaseLayout title={t(lang, 'updates.pageTitle')} description={t(lang, 'updates.description')}>
  <SchemaArticle
    headline="ChillShell v1.0.0 (BÉTA) Release Notes"
    description="First beta release of ChillShell mobile SSH terminal. SSH, Wake-on-LAN, Tailscale, 12 themes, 5 languages."
    url="https://chill.app/updates"
    datePublished="2026-02-09"
    dateModified="2026-02-14"
  />

  <section class="py-[var(--spacing-section)]">
    <!-- Title -->
    <h1 data-animate="0" class="text-hero-h1 font-heading font-bold text-chill-text mb-12">
      {t(lang, 'updates.title')}
    </h1>

    <!-- Current version card -->
    <div data-animate="150" class="mb-12 rounded-chill-xl border-2 border-chill-accent bg-chill-elevated p-8">
      <div class="flex items-center gap-3 mb-4">
        <span class="inline-flex items-center rounded-chill-sm bg-chill-accent/10 px-3 py-1 text-code font-mono font-bold text-chill-accent">
          {t(lang, 'updates.current')}
        </span>
      </div>

      <h2 class="text-h2 font-heading font-bold text-chill-text mb-2">
        v1.0.0 <span class="text-chill-accent">(BÉTA)</span>
      </h2>
      <p class="text-body-sm text-chill-text-muted mb-2 font-mono">
        2026-02-09
      </p>
      <p class="text-micro text-chill-text-secondary mb-6">
        Android only — iOS and macOS not tested
      </p>

      <div class="mb-8">
        <h3 class="text-h3 font-heading font-semibold text-chill-text mb-4">Features</h3>
        <ul class="space-y-3 text-body-sm text-chill-text-secondary">
          <li class="flex items-start gap-3">
            <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-chill-accent"></span>
            SSH terminal with full xterm rendering
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-chill-accent"></span>
            Local Wake-on-LAN (magic packet over Ethernet)
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-chill-accent"></span>
            12 color themes
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-chill-accent"></span>
            5 languages (English, French, Spanish, German, Chinese)
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-chill-accent"></span>
            Compatible with CLI agents — Claude Code, Codex CLI, Gemini, Kimi Code, and more
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-chill-accent"></span>
            Biometric authentication &amp; PIN lock
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-chill-accent"></span>
            Ed25519 SSH key generation &amp; secure storage
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-chill-accent"></span>
            Native Android speech-to-text
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-chill-accent"></span>
            Native Tailscale integration
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-chill-accent"></span>
            Smart completion <span class="text-micro text-chill-text-muted">(level 1 — in development)</span>
          </li>
        </ul>
      </div>

      <a
        href="https://github.com/Kevin-hDev"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 rounded-chill bg-chill-accent px-6 py-3 text-body-sm font-heading font-bold text-white transition-colors hover:bg-chill-accent-hover"
      >
        <img src="/images/icons_github.png" alt="GitHub" width="34" height="34" class="h-[34px] w-auto" />
        {t(lang, 'updates.download')}
      </a>
    </div>

    <!-- Previous versions -->
    <h2 data-animate="0" class="text-h3 font-heading font-semibold text-chill-text mb-4">
      {t(lang, 'updates.previous')}
    </h2>

    <div data-animate="100" class="space-y-4">
      <div class="rounded-chill border border-chill-border bg-chill-elevated overflow-hidden">
        <h3 class="px-5 py-3 text-body-sm font-medium text-chill-text font-heading">No previous versions yet</h3>
        <div class="px-5 pb-4 pt-1 border-t border-chill-border bg-chill-surface">
          <p class="text-body-sm text-chill-text-muted leading-relaxed">
            This is the first release of ChillShell. Previous versions will appear here as updates are published.
          </p>
        </div>
      </div>
    </div>

    <AuthorDate datePublished="2026-02-09" dateModified="2026-02-14" />
  </section>
</BaseLayout>
