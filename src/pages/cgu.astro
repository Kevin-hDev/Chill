---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, t } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
---

<BaseLayout title={t(lang, 'legal.terms.pageTitle')} description={t(lang, 'legal.terms.description')}>
  <section class="py-[var(--spacing-section)]">
    <h1 data-animate="0" class="text-hero-h1 font-heading font-bold text-chill-text mb-12">
      {t(lang, 'legal.terms.title')}
    </h1>

    <div data-animate="150" class="space-y-10 text-body-sm text-chill-text-secondary leading-relaxed">
      <!-- Article 1 - Purpose -->
      <div class="rounded-chill border border-chill-border bg-chill-elevated p-6">
        <h2 class="text-h3 font-heading font-semibold text-chill-text mb-3">
          1. Purpose
        </h2>
        <p>
          These Terms of Service govern the use of the ChillShell (mobile) and Chill (desktop) applications, hereinafter "the Applications." By downloading, installing, or using the Applications, you agree to be bound by these terms. If you do not agree with any part of these terms, you must not use the Applications.
        </p>
      </div>

      <!-- Article 2 - Access -->
      <div class="rounded-chill border border-chill-border bg-chill-elevated p-6">
        <h2 class="text-h3 font-heading font-semibold text-chill-text mb-3">
          2. Access to the Service
        </h2>
        <p>
          The Applications are provided free of charge. They are available through distribution platforms (Google Play, App Store) or via direct download from this website.
        </p>
      </div>

      <!-- Article 3 - License -->
      <div class="rounded-chill border border-chill-border bg-chill-elevated p-6">
        <h2 class="text-h3 font-heading font-semibold text-chill-text mb-3">
          3. License
        </h2>
        <p>
          The Applications are licensed, not sold. You are granted a free, non-exclusive, non-transferable, revocable license to use the Applications for personal purposes on devices you own.
        </p>
      </div>

      <!-- Article 4 - Restrictions -->
      <div class="rounded-chill border border-chill-border bg-chill-elevated p-6">
        <h2 class="text-h3 font-heading font-semibold text-chill-text mb-3">
          4. Restrictions
        </h2>
        <p class="mb-3">You agree not to:</p>
        <ul class="list-disc list-inside space-y-2 pl-2">
          <li>Redistribute, sublicense, sell, or lease the Applications to any third party</li>
          <li>Reverse engineer, decompile, disassemble, or attempt to derive the source code of the Applications</li>
          <li>Modify, adapt, translate, or create derivative works based on the Applications</li>
          <li>Remove, alter, or obscure any proprietary notices in the Applications</li>
          <li>Use the Applications for any unlawful purpose or in violation of applicable laws</li>
        </ul>
      </div>

      <!-- Article 5 - Intellectual Property -->
      <div class="rounded-chill border border-chill-border bg-chill-elevated p-6">
        <h2 class="text-h3 font-heading font-semibold text-chill-text mb-3">
          5. Intellectual Property
        </h2>
        <p>
          The Applications, including their design, code, graphics, and content, are the exclusive property of the publisher. All intellectual property rights are reserved.
        </p>
      </div>

      <!-- Article 6 - Liability -->
      <div class="rounded-chill border border-chill-border bg-chill-elevated p-6">
        <h2 class="text-h3 font-heading font-semibold text-chill-text mb-3">
          6. Limitation of Liability
        </h2>
        <p>
          The Applications are provided "as is" without warranty of any kind. The publisher shall not be held liable for any direct or indirect damages arising from the use or inability to use the Applications, including data loss or security breaches on connected devices. You use the Applications at your own risk, particularly when establishing SSH connections to remote systems.
        </p>
      </div>

      <!-- Article 7 - Modifications -->
      <div class="rounded-chill border border-chill-border bg-chill-elevated p-6">
        <h2 class="text-h3 font-heading font-semibold text-chill-text mb-3">
          7. Modifications
        </h2>
        <p>
          The publisher reserves the right to modify these terms at any time. Continued use of the Applications after such modifications constitutes your acceptance of the revised terms.
        </p>
      </div>

      <!-- Article 8 - Governing Law -->
      <div class="rounded-chill border border-chill-border bg-chill-elevated p-6">
        <h2 class="text-h3 font-heading font-semibold text-chill-text mb-3">
          8. Governing Law
        </h2>
        <p>
          These terms are governed by French law. Any disputes arising from or relating to these terms shall be subject to the jurisdiction of the competent French courts.
        </p>
      </div>

      <!-- Last updated -->
      <p class="text-micro text-chill-text-muted text-center pt-4">
        Last updated: February 13, 2026
      </p>
    </div>
  </section>
</BaseLayout>
